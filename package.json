{
  "name": "delivery-tracker",
  "version": "1.0.0",
  "description": "Last-Mile Delivery Tracker — Full-stack Node.js + React",
  "scripts": {
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
